        "@types/morgan": "^1.9.10",
        "@types/multer": "^2.0.0",
        "@types/validatorjs": "^3.15.5",
        "axios": "^1.6.8",
        "body-parser": "^2.2.1",
        "cookie-parser": "^1.4.6",
        "cors": "^2.8.5",
        "crypto-js": "^4.2.0",
        "dotenv": "^17.2.3",
        "express": "^5.2.1",
        "helmet": "^8.1.0",
        "morgan": "^1.10.0",
